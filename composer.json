{
  "name": "tetthys/notification",
  "description": "Framework-agnostic notification core with a thin Laravel integration.",
  "type": "library",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "Tetthys\\Notification\\Core\\": "src/Core/",
      "Tetthys\\Notification\\Integration\\Laravel\\": "src/Integration/Laravel/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Tetthys\\Notification\\Integration\\Laravel\\LaravelNotificationServiceProvider"
      ]
    }
  },
  "require": {
    "php": ">=8.5",
    "illuminate/support": "^12.0",
    "illuminate/contracts": "^12.0",
    "illuminate/queue": "^12.0",
    "illuminate/mail": "^12.0"
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
